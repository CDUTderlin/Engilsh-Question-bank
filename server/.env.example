PORT=3100
NODE_ENV=development

# Fill these with your WeChat Mini Program credentials.
WECHAT_APPID=
WECHAT_SECRET=

# Change this before deploying. Use a long random string.
JWT_SECRET=change-me-in-production

# Comma-separated origins for browser/H5 development.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Local-only helper. Set to false on the server.
WECHAT_LOGIN_MOCK=true
